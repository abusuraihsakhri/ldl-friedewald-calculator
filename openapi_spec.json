{
  "openapi": "3.1.0",
  "info": {
    "title": "LDL-C Calculator API",
    "description": "LDL-C equations plus legacy mock audit endpoints",
    "version": "1.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Basic service health"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy in-memory JSON counters",
        "responses": {
          "200": {
            "description": "JSON metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy demonstration-only audit supervisor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock supervisory query (not a verified clinical interpretation)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/ldl": {
      "post": {
        "summary": "Estimate LDL-C with validity flags (mg/dL)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "total_cholesterol",
                  "hdl",
                  "triglycerides"
                ],
                "properties": {
                  "total_cholesterol": {
                    "type": "number",
                    "minimum": 0
                  },
                  "hdl": {
                    "type": "number",
                    "minimum": 0
                  },
                  "triglycerides": {
                    "type": "number",
                    "minimum": 0
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "friedewald",
                      "sampson",
                      "martin-hopkins"
                    ],
                    "default": "friedewald"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LDL-C, formula, validity, and reason if not reportable"
          },
          "422": {
            "description": "Invalid input panel or method"
          }
        }
      }
    }
  }
}
